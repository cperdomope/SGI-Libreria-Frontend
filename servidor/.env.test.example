# =====================================================
# PLANTILLA DE VARIABLES PARA LAS PRUEBAS AUTOMATIZADAS
# =====================================================
# 1. Copia este archivo:  cp .env.test.example .env.test
# 2. Completa los valores con usuarios que existan en la base de datos
# 3. NUNCA versiones el archivo .env.test en Git
#
# Estas credenciales deben corresponder a usuarios reales creados por
# base_datos/sgi_libreria_completo.sql. Si no coinciden, la suite falla
# de inmediato con un mensaje explicando que revisar: es intencional.
#
# Antes las credenciales estaban escritas dentro de los archivos .test.js
# con un valor por defecto equivocado, y eso mantuvo la suite en verde
# falso: las pruebas se aprobaban sin llegar a ejecutarse.
# =====================================================

# --- USUARIO ADMINISTRADOR (rol_id = 1) ---
# Necesario para probar rutas privilegiadas: usuarios, movimientos,
# proveedores, dashboard y anulacion de ventas.
TEST_ADMIN_EMAIL=correo_del_admin@ejemplo.com
TEST_ADMIN_PASSWORD=contrasena_del_admin

# --- USUARIO VENDEDOR (rol_id = 2) ---
# Necesario para probar que el RBAC bloquea correctamente:
# un vendedor debe recibir 403 en las rutas de administrador.
TEST_VENDEDOR_EMAIL=correo_del_vendedor@ejemplo.com
TEST_VENDEDOR_PASSWORD=contrasena_del_vendedor
